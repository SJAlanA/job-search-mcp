# Copy this file to .env and adjust if you want non-default paths.
# .env is gitignored -- never commit real values.

# Path to the Google OAuth client secret JSON you downloaded from
# Google Cloud Console (Desktop app credential type).
GOOGLE_CLIENT_SECRET_PATH=./credentials/client_secret.json

# Where the cached user OAuth token is written after the first
# interactive consent flow (created automatically, don't create by hand).
GOOGLE_TOKEN_PATH=./credentials/token.json

# Where the SQLite tracker and error log live.
JOB_SEARCH_DATA_DIR=./data
